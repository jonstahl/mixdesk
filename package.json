{
  "name": "mixdesk",
  "private": true,
  "version": "1.1.0",
  "description": "A web interface for Lyrion Music Server built around previewing and pruning MusicIP mixes",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonstahl/mixdesk"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "package": "node scripts/package.mjs",
    "deploy": "node --env-file-if-exists=.env.local scripts/deploy.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
